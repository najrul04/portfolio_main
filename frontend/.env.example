# GraphQL endpoint — must be NEXT_PUBLIC_* to be readable in the browser.
# Why public: Apollo Client runs in the browser, so it must know the URL at build time.
# This is not a secret (anyone hitting the site can see it in DevTools); the API itself
# is what protects writes via JWT.
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:4000/graphql"

# Base URL for the backend's REST endpoints (image upload/serve). Used by the
# admin markdown editor to POST images. Public for the same reason as above.
NEXT_PUBLIC_API_URL="http://localhost:4000"
