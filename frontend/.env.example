# GraphQL endpoint — must be NEXT_PUBLIC_* to be readable in the browser.
# Why public: Apollo Client runs in the browser, so it must know the URL at build time.
# This is not a secret (anyone hitting the site can see it in DevTools); the API itself
# is what protects writes via JWT.
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:4000/graphql"

# Base URL for the backend's REST endpoints (image upload/serve). Used by the
# admin markdown editor to POST images. Public for the same reason as above.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Resend API key for the contact form (server-side only — NO NEXT_PUBLIC prefix,
# it must never reach the browser). Create at resend.com -> API Keys.
RESEND_API_KEY="re_..."

# Where contact form messages are delivered. Defaults to nazrul2517@gmail.com
# (must be the Resend account owner email until najrul.com is verified in Resend).
# CONTACT_TO_EMAIL="nazrul2517@gmail.com"

# From-address. Until najrul.com is verified in Resend this MUST stay the
# default onboarding@resend.dev sender (set nothing). After domain verification:
# CONTACT_FROM_EMAIL="Portfolio Contact <contact@najrul.com>"
