# GraphQL endpoint — exposed to the browser, prefix MUST be VITE_ for Vite to ship it.
# Not a secret — anyone hitting the site can read it in DevTools. The API protects
# itself via JWT, not via URL obscurity.
VITE_GRAPHQL_URL=http://localhost:4000/graphql
# Base URL for REST endpoints (image upload + serve). Same origin as GraphQL.
VITE_API_URL=http://localhost:4000
