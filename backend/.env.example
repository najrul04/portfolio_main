# Postgres connection string. See README "Database setup" for options (Neon, Docker, native).
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# Used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-32-byte-random-hex-string"

# How long an admin login token stays valid
JWT_EXPIRES_IN="7d"

# Server port
PORT=4000

# CORS — frontend origin(s) allowed to call this API. Comma-separate to allow multiple.
# Vite dev server runs on :5173 by default; Next.js runs on :3000.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Used by `npm run seed` to create the admin account
ADMIN_EMAIL="admin@najrul.com"
